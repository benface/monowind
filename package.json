{
  "name": "monowind-monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "Text-based user interfaces (TUI) on the web, from ordinary HTML and Tailwind utility classes",
  "license": "MIT",
  "scripts": {
    "dev": "pnpm --filter @monowind/storybook dev",
    "check": "node scripts/check-workspace-deps.mjs && oxlint && oxfmt --check && pnpm -r typecheck && pnpm -r test",
    "check:fix": "node scripts/check-workspace-deps.mjs && oxlint --fix && oxfmt && pnpm -r typecheck && pnpm -r test",
    "check-updates": "ncu -iu --deep",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:visual": "node scripts/test-visual.mjs",
    "test:visual:update": "node scripts/test-visual.mjs --update-snapshots",
    "build": "pnpm -r build",
    "prepare": "husky"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^17.5.0",
    "npm-check-updates": "^23.1.0",
    "oxfmt": "^0.66.0",
    "oxlint": "^1.81.0",
    "playwright": "^1.63.0"
  },
  "lint-staged": {
    "*.{js,jsx,mjs,cjs,ts,tsx}": [
      "oxlint --fix",
      "oxfmt"
    ],
    "*.{json,jsonc,css,html,md,mdx,yaml,yml}": [
      "oxfmt"
    ]
  },
  "packageManager": "pnpm@12.3.4+sha512.961aa41fb077da3a04a441d9f8e15ebc0c96da8ef710b2eb67bf9ee7cb0610eabd48f1fd85f51cffe73846785fa0f87c56a3a872a1d893f8446741b5cce45457"
}
