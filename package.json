{
  "name": "monowind-monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "Text-based user interfaces (TUI) on the web, from ordinary HTML and Tailwind utility classes",
  "license": "MIT",
  "scripts": {
    "dev": "pnpm --filter @monowind/storybook dev",
    "check": "node scripts/check-workspace-deps.mjs && oxlint && oxfmt --check && pnpm -r typecheck",
    "check:fix": "node scripts/check-workspace-deps.mjs && oxlint --fix && oxfmt && pnpm -r typecheck",
    "check-updates": "ncu -iu --deep",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r --workspace-concurrency=1 test",
    "test:visual": "node scripts/test-visual.mjs",
    "test:visual:update": "node scripts/test-visual.mjs --update-snapshots",
    "build": "pnpm -r build",
    "prepare": "husky"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "npm-check-updates": "^23.1.0",
    "oxfmt": "^0.68.0",
    "oxlint": "^1.83.0",
    "playwright": "^1.63.0"
  },
  "lint-staged": {
    "*.{js,jsx,mjs,cjs,ts,tsx}": [
      "oxlint --fix",
      "oxfmt"
    ],
    "*.{json,jsonc,css,html,md,mdx,yaml,yml}": [
      "oxfmt"
    ]
  },
  "packageManager": "pnpm@12.4.2+sha512.08adc6613180275c7c9edada39dcf08c9c61ad4e7eaf330a4f3461f102b0f907423454d117f98e72d47fef0616070644d7bffc973a6a57f5090a6d7c368b07c9"
}
