{
  "name": "monowind-monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "Text-based user interfaces (TUI) on the web, from ordinary HTML and Tailwind utility classes",
  "license": "MIT",
  "scripts": {
    "dev": "pnpm --filter @monowind/storybook dev",
    "check": "node scripts/check-workspace.mjs && node scripts/check-canonical-classes.mjs && oxlint && oxfmt --check && pnpm -r typecheck",
    "check:fix": "node scripts/check-workspace.mjs && node scripts/check-canonical-classes.mjs --fix && oxlint --fix && oxfmt && pnpm -r typecheck",
    "deps:check": "ncu",
    "deps:update": "ncu --interactive --upgrade",
    "typecheck": "pnpm -r typecheck",
    "test": "node scripts/test.mjs",
    "test:visual": "node scripts/test-visual.mjs",
    "test:visual:update": "node scripts/test-visual.mjs --update-snapshots",
    "bench": "node scripts/bench.mjs",
    "build": "pnpm -r build",
    "prepare": "husky"
  },
  "devDependencies": {
    "@tailwindcss/node": "^4.3.3",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "npm-check-updates": "^23.1.0",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.86.0",
    "playwright": "^1.63.0"
  },
  "lint-staged": {
    "*.{js,jsx,mjs,cjs,ts,tsx}": [
      "oxlint --fix",
      "oxfmt"
    ],
    "*.{json,jsonc,css,html,md,mdx,yaml,yml}": [
      "oxfmt"
    ]
  },
  "packageManager": "pnpm@12.8.1+sha512.f64ba907507f5ceafe06c8d38e6052d0179444580ec1279ddd5bfc11cb48aa8a2644b66598e07e761da84872a9fc57d5f902b87fa49d024198d558612aabbe45"
}
