{
  "name": "monowind-monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "Text-based user interfaces (TUI) on the web, from ordinary HTML and Tailwind utility classes",
  "license": "MIT",
  "scripts": {
    "dev": "pnpm --filter @monowind/storybook dev",
    "check": "node scripts/check-workspace-deps.mjs && node scripts/check-canonical-classes.mjs && oxlint && oxfmt --check && pnpm -r typecheck",
    "check:fix": "node scripts/check-workspace-deps.mjs && node scripts/check-canonical-classes.mjs --fix && oxlint --fix && oxfmt && pnpm -r typecheck",
    "check-updates": "ncu -iu --deep",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r --workspace-concurrency=1 test",
    "test:visual": "node scripts/test-visual.mjs",
    "test:visual:update": "node scripts/test-visual.mjs --update-snapshots",
    "bench": "node scripts/bench.mjs",
    "build": "pnpm -r build",
    "prepare": "husky"
  },
  "devDependencies": {
    "@tailwindcss/node": "^4.3.3",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "npm-check-updates": "^23.1.0",
    "oxfmt": "^0.70.0",
    "oxlint": "^1.85.0",
    "playwright": "^1.63.0"
  },
  "lint-staged": {
    "*.{js,jsx,mjs,cjs,ts,tsx}": [
      "oxlint --fix",
      "oxfmt"
    ],
    "*.{json,jsonc,css,html,md,mdx,yaml,yml}": [
      "oxfmt"
    ]
  },
  "packageManager": "pnpm@12.5.1+sha512.e3f305bc784a2bc89f5ad3b6138889470fae8d2af5f36b61216ec91c2c3d64089775f9de38aac331044ea40f245cb0d5666392dfdf65824e1907ef6a2c62de5f"
}
