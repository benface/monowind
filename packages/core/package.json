{
  "name": "monowind",
  "version": "0.2.1",
  "description": "Text-based user interfaces (TUI) on the web, from ordinary HTML and Tailwind utility classes",
  "keywords": [
    "ascii",
    "monospace",
    "tailwind",
    "terminal",
    "text-based",
    "tui",
    "web-component"
  ],
  "license": "MIT",
  "author": "Benoît Rouleau",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/benface/monowind.git",
    "directory": "packages/core"
  },
  "style": "./src/styles.css",
  "files": [
    "dist",
    "src/*.css"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "style": "./src/styles.css",
      "typecheck": "./dist/index.d.ts",
      "default": "./src/index.ts"
    },
    "./styles.css": "./src/styles.css",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "style": "./src/styles.css",
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./styles.css": "./src/styles.css",
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "build": "vite build && vite build -c vite.cdn.config.ts && vite build -c vite.sort.config.ts && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepack": "node -e \"require('fs').copyFileSync('../../LICENSE', 'LICENSE')\"",
    "prepublishOnly": "pnpm build",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@tailwindcss/browser": "^4.3.3",
    "@vitest/coverage-v8": "4.1.11",
    "happy-dom": "^20.12.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
