{
  "name": "@monowind/ui-react",
  "version": "0.3.1",
  "description": "@monowind/ui as React hooks: a menu, a listbox, a select, a dialog, a popover, a tooltip on the monowind grid",
  "keywords": [
    "accessibility",
    "components",
    "listbox",
    "monowind",
    "react",
    "tui",
    "zag-js"
  ],
  "license": "MIT",
  "author": "Benoît Rouleau",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/benface/monowind.git",
    "directory": "packages/ui-react"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "typecheck": "./dist/index.d.ts",
      "default": "./src/index.ts"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepack": "node -e \"require('fs').copyFileSync('../../LICENSE', 'LICENSE')\"",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "@monowind/ui": "workspace:^",
    "@zag-js/react": "^1.44.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@zag-js/core": "^1.44.0",
    "happy-dom": "^20.14.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  }
}
