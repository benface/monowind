{
  "name": "@monowind/ascii",
  "version": "0.3.2",
  "description": "FIGlet/TOIlet ascii-art banner text for monowind: the <mono-ascii> element and a font library",
  "keywords": [
    "ascii-art",
    "banner",
    "figlet",
    "monowind",
    "toilet",
    "tui"
  ],
  "license": "MIT",
  "author": "Benoît Rouleau",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/benface/monowind.git",
    "directory": "packages/ascii"
  },
  "style": "./src/styles.css",
  "files": [
    "dist",
    "src/*.css",
    "fonts"
  ],
  "type": "module",
  "sideEffects": [
    "./src/index.ts",
    "./src/fonts/*.ts",
    "./dist/index.js",
    "./dist/fonts/*.js"
  ],
  "exports": {
    ".": {
      "style": "./src/styles.css",
      "typecheck": "./dist/index.d.ts",
      "default": "./src/index.ts"
    },
    "./fonts/*": "./src/fonts/*.ts",
    "./styles.css": "./src/styles.css",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "style": "./src/styles.css",
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./fonts/*": "./dist/fonts/*.js",
      "./styles.css": "./src/styles.css",
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "build": "node scripts/generate-fonts.mjs && vite build && vite build -c vite.cdn.config.ts && tsc -p tsconfig.build.json && node scripts/strip-font-maps.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepack": "node -e \"require('fs').copyFileSync('../../LICENSE', 'LICENSE')\"",
    "prepublishOnly": "pnpm build"
  },
  "devDependencies": {
    "@types/figlet": "^1.7.0",
    "@types/node": "^26.6.2",
    "figlet": "^1.11.4",
    "happy-dom": "^20.14.5",
    "monowind": "workspace:^",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  },
  "peerDependencies": {
    "monowind": "workspace:^"
  }
}
