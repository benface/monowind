{
  "name": "@monowind/ui",
  "version": "0.3.0",
  "description": "Accessible components on the monowind grid: Zag.js machines placed and layered by the engine",
  "keywords": [
    "accessibility",
    "components",
    "dialog",
    "menu",
    "monowind",
    "popover",
    "tooltip",
    "tui",
    "zag-js"
  ],
  "license": "MIT",
  "author": "Benoît Rouleau",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/benface/monowind.git",
    "directory": "packages/ui"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./menu": {
      "typecheck": "./dist/menu.d.ts",
      "default": "./src/menu.ts"
    },
    "./dialog": {
      "typecheck": "./dist/dialog.d.ts",
      "default": "./src/dialog.ts"
    },
    "./popover": {
      "typecheck": "./dist/popover.d.ts",
      "default": "./src/popover.ts"
    },
    "./tooltip": {
      "typecheck": "./dist/tooltip.d.ts",
      "default": "./src/tooltip.ts"
    },
    "./top-layer": {
      "typecheck": "./dist/top-layer.d.ts",
      "default": "./src/top-layer.ts"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      "./menu": {
        "types": "./dist/menu.d.ts",
        "default": "./dist/menu.js"
      },
      "./dialog": {
        "types": "./dist/dialog.d.ts",
        "default": "./dist/dialog.js"
      },
      "./popover": {
        "types": "./dist/popover.d.ts",
        "default": "./dist/popover.js"
      },
      "./tooltip": {
        "types": "./dist/tooltip.d.ts",
        "default": "./dist/tooltip.js"
      },
      "./top-layer": {
        "types": "./dist/top-layer.d.ts",
        "default": "./dist/top-layer.js"
      },
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "build": "vite build && vite build -c vite.cdn.config.ts && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepack": "node -e \"require('fs').copyFileSync('../../LICENSE', 'LICENSE')\"",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "@zag-js/core": "^1.44.0",
    "@zag-js/dialog": "^1.44.0",
    "@zag-js/menu": "^1.44.0",
    "@zag-js/popover": "^1.44.0",
    "@zag-js/tooltip": "^1.44.0",
    "@zag-js/types": "^1.44.0",
    "@zag-js/vanilla": "^1.44.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.1",
    "happy-dom": "^20.14.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
